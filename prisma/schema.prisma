// ──────────────────────────────────────────────────
// Prisma Schema — PostgreSQL
// ──────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────
// User
// ──────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?

  role     UserRole @default(USER)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  @@index([clerkId])
  @@index([email])
  @@index([role])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

// ──────────────────────────────────────────────────
// Organization
// ──────────────────────────────────────────────────
model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  timezone    String   @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  websites    Website[]

  @@index([slug])
  @@map("organizations")
}

// ──────────────────────────────────────────────────
// Membership
// ──────────────────────────────────────────────────
enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id String @id @default(uuid())

  userId         String
  organizationId String

  role MembershipRole @default(MEMBER)

  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ──────────────────────────────────────────────────
// Website
// ──────────────────────────────────────────────────

model Website {
  id               String    @id @default(uuid())
  organizationId   String
  name             String
  domain           String
  normalizedDomain String
  faviconUrl       String?
  verified         Boolean   @default(false)
  lastScanAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans       Scan[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, normalizedDomain])
  @@index([organizationId])
  @@map("websites")
}

// ──────────────────────────────────────────────────
// Scan
// ──────────────────────────────────────────────────

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Scan {
  id        String     @id @default(uuid())
  websiteId String

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  pages   Page[]
  pageScores PageScore[]

  status ScanStatus @default(PENDING)

  startedAt  DateTime?
  finishedAt DateTime?

  pagesFound   Int @default(0)
  pagesCrawled Int @default(0)
  pagesFailed  Int @default(0)

  error String?

  // Scan summary — AI Visibility Score statistics.
  averageScore Float?
  highestScore Float?
  lowestScore  Float?
  pagesScored  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([websiteId])
  @@index([status])
  @@map("scans")
}

// ──────────────────────────────────────────────────
// Page
// ──────────────────────────────────────────────────

model Page {
  id        String   @id @default(uuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  // General
  url         String
  finalUrl    String
  statusCode  Int
  contentType String

  // SEO
  title           String?
  metaDescription String?
  canonical       String?
  robots          String?

  // Social
  openGraph Json?
  twitter   Json?

  // Structure
  language String?
  charset  String?
  viewport String?

  // Collections
  headings       Json?
  images         Json?
  links          Json?
  structuredData Json?

  // Metadata
  crawlDepth          Int
  parentUrl           String?
  source              String
  warnings            Json?
  downloadDurationMs  Int
  extractionDurationMs Int

  createdAt DateTime @default(now())

  pageScore PageScore?

  @@index([scanId])
  @@index([url])
  @@index([statusCode])
  @@map("pages")
}

// ──────────────────────────────────────────────────
// PageScore
// ──────────────────────────────────────────────────

model PageScore {
  id        String   @id @default(uuid())
  pageId    String   @unique
  scanId    String

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  /** Overall AI Visibility Score (0–100). */
  overallScore Int

  /** Per-category scoring breakdown (JSON). */
  categoryScores Json

  /** Deductions applied during scoring (JSON). */
  deductions Json

  /** Generated recommendations (JSON). */
  recommendations Json

  /** When the score was computed. */
  scoredAt DateTime @default(now())

  @@index([scanId])
  @@index([pageId])
  @@map("page_scores")
}
